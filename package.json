{
    "name": "santu-infinite-canvas",
    "version": "0.2.1",
    "description": "Local-first single-user AI creation workspace with an infinite canvas.",
    "author": "Santu Infinite Canvas contributors",
    "private": true,
    "main": "desktop/main.js",
    "type": "module",
    "packageManager": "pnpm@11.19.0",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "vite --host 0.0.0.0 --port 5200 --strictPort",
        "dev:backend": "node --disable-warning=ExperimentalWarning desktop/start-dev-backend.js",
        "test:local": "node --test server/tests/local-workspace-http.test.mjs",
        "test:canvas-performance": "node server/tests/canvas-performance.test.mjs",
        "test:director-static-ui": "node --test server/tests/director-static-ui.test.mjs",
        "test:top-nav-static-ui": "node --test server/tests/top-nav-static-ui.test.mjs",
        "test:asset-change-repository": "node server/tests/asset-change-repository.test.mjs",
        "build": "vite build",
        "typecheck": "tsc --noEmit",
        "start": "node server.js",
        "start:browser": "node desktop/start-browser.js",
        "desktop": "vite build && electron .",
        "pack:win": "vite build && electron-builder --win nsis portable zip --x64 --publish never --config.directories.output=Windows",
        "pack:win:zip": "vite build && electron-builder --win zip --x64 --publish never --config.directories.output=Windows",
        "pack:mac": "vite build && electron-builder --mac dmg zip --arm64 --publish never --config.directories.output=macOS",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@ant-design/icons": "^6.1.1",
        "@ant-design/pro-components": "3.0.0-beta.3",
        "@codemirror/lang-json": "^6.0.2",
        "@tanstack/react-query": "^5.100.9",
        "@uiw/react-codemirror": "^4.25.9",
        "antd": "^6.4.2",
        "axios": "^1.16.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "copy-to-clipboard": "^4.0.2",
        "dayjs": "^1.11.20",
        "fflate": "^0.8.3",
        "file-saver": "^2.0.5",
        "localforage": "^1.10.0",
        "lucide-react": "^1.16.0",
        "motion": "^12.38.0",
        "nanoid": "^5.1.11",
        "radix-ui": "^1.4.3",
        "react": "19.2.5",
        "react-dom": "19.2.5",
        "react-router": "^7.12.0",
        "react-router-dom": "^7.12.0",
        "shadcn": "^4.7.0",
        "streamdown": "^2.5.0",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4",
        "tw-animate-css": "^1.4.0",
        "zustand": "^5.0.12"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@types/file-saver": "^2.0.7",
        "@types/node": "^20",
        "@types/react": "19.1.12",
        "@types/react-dom": "19.1.9",
        "@vitejs/plugin-react": "^5.2.0",
        "prettier": "^3.8.3",
        "typescript": "^5",
        "vite": "^7.3.0",
        "electron": "^39.0.0",
        "electron-builder": "^26.0.0"
    },
    "build": {
        "appId": "cn.santu.infinitecanvas",
        "productName": "Santu Infinite Canvas",
        "asar": true,
        "directories": {
            "output": "Windows"
        },
        "files": [
            "dist/**",
            "desktop/main.js",
            "server.js",
            "server/lib/**",
            "package.json"
        ],
        "win": {
            "target": [
                "nsis",
                "portable",
                "zip"
            ]
        },
        "mac": {
            "target": [
                "dmg",
                "zip"
            ],
            "category": "public.app-category.graphics-design",
            "identity": "-",
            "hardenedRuntime": false,
            "artifactName": "${productName}-${version}-${arch}.${ext}"
        },
        "nsis": {
            "artifactName": "${productName}-${version}-${arch}-setup.${ext}",
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true
        },
        "portable": {
            "artifactName": "${productName}-${version}-${arch}-portable.${ext}"
        }
    }
}
